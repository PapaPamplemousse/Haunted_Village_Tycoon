# ==========================================
#  BASIC MOVEMENT & SURVIVAL
# ==========================================

[WANDER_BASIC]
rule = wander
categories = humanoid

[RETURN_VILLAGE_CORE_HUMAN]
rule = return_village_core
species = human

[FLEE_HUMAN]
rule = flee
species = human

[SEEK_FOOD_HUMANOID]
rule = seek_food
categories = humanoid

[REST_HUMAN]
rule = rest
species = human

# ==========================================
#  COMBAT & SECURITY
# ==========================================

[DEFEND_HUMAN]
rule = defend
species = human

[HUNT_HUNTER]
rule = hunt(zombie, cannibal)
professions = hunter, guard

[GUARD_GUARD]
rule = guard
professions = guard, watchman

[PATROL_GUARD]
rule = patrol
professions = guard, watchman

[EQUIP_WEAPON_GUARD]
rule = equip_weapon
professions = guard, watchman

[REQUEST_WEAPON_GUARD]
rule = request_weapon
professions = guard, watchman


# ==========================================
#  RESOURCE GATHERING
# ==========================================

[HARVEST_BUSH_GATHERER]
rule = harvest(BUSH_BERRY)
professions = gatherer

[STORE_GATHERER]
rule = store
professions = gatherer

[FIND_WEAPON_LUMBERJACK]
rule = find(axe)
professions = lumberjack

[HARVEST_OAK_LUMBERJACK]
rule = harvest(TREE_OAK)
professions = lumberjack

[STORE_LUMBERJACK]
rule = store
professions = lumberjack

[HARVEST_STONE_MINER]
rule = harvest(STONE_ROCK)
professions = miner

[STORE_MINER]
rule = store
professions = miner

# ==========================================
#  LOGISTICS & HAULING
# ==========================================

[HAUL_CARRIER]
rule = haul
professions = carrier, hauler

[STORE_CARRIER]
rule = store
professions = carrier, hauler

[FULFILL_WEAPON_REQUEST_BLACKSMITH]
rule = fulfill_weapon_request
professions = blacksmith

[STORE_BLACKSMITH]
rule = store
professions = blacksmith

# ==========================================
#  CONSTRUCTION & MAINTENANCE
# ==========================================

[BUILD_BUILDER]
rule = build
professions = builder

[DISMANTLE_BUILDER]
rule = dismantle
professions = builder, demolisher

[REPAIR_BUILDER]
rule = repair
professions = builder , repairer

# ==========================================
#  CAMP LIFE, FIRE & FOOD
# ==========================================

[LIGHT_FIRE_FIREKEEPER]
rule = light_fire
professions = firekeeper

[REFUEL_FIREKEEPER]
rule = refuel
professions = firekeeper

[COOK_COOK]
rule = cook
professions = cook

# ==========================================
#  SOCIAL & CARE
# ==========================================

[CARE_CHILD_HUMAN]
rule = care_child
species = human

[CARE_CHILD_CARETAKER]
rule = care_child
professions = caretaker

[SOCIALIZE_HUMAN]
rule = socialize
species = human

[AVOID_PERSON_HUMAN]
rule = avoid_person
species = human

[CONFRONT_PERSON_HUMAN]
rule = confront_person
species = human

# ==========================================
#  CANNIBAL
# ==========================================
[REST_CANNIBAL]
rule = rest
species = cannibal

[DEFEND_CANNIBAL]
rule = defend
species = cannibal

[HUNT_CANNIBAL]
rule = hunt(human)
species = cannibal
